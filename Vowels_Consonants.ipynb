   ],
   "source": [
    "text = input(\"Enter string: \")\n",
    "\n",
    "v = 0\n",
    "c = 0\n",
    "\n",
    "for i in text:\n",
    "    if i in \"aeiouAEIOU\":\n",
    "        v = v + 1\n",
    "    elif i.isalpha():\n",
    "        c = c + 1\n",
    "\n",
    "print(\"Vowels:\", v)\n",
    "print(\"Consonants:\", c)"
   ]
  },
